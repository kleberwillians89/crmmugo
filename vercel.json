{
  "env": {
    "VITE_META_TOKEN_EXPIRES_AT": "2026-09-25T23:59:59-03:00",
    "VITE_WHATSAPP_TEMPLATE_SEND_ENABLED": "false",
    "VITE_WHATSAPP_TEMPLATE_TEST_ENABLED": "true"
  },
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "newsletter.mugoagencia.com.br"
        }
      ],
      "dest": "/news/index.html"
    },
    {
      "src": "/confirmar/?",
      "has": [
        {
          "type": "host",
          "value": "newsletter.mugoagencia.com.br"
        }
      ],
      "dest": "/news/confirmar.html"
    },
    {
      "src": "/news/?",
      "dest": "/news/index.html"
    },
    {
      "src": "/news/confirmar/?",
      "dest": "/news/confirmar.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
